RESEND_API_KEY=

TACOS_API_URL=
TACOS_API_KEY=

REVALIDATE_SECRET=

# Blog studio: write posts at /studio/<STUDIO_KEY>. Use a long random string (32+ chars).
STUDIO_KEY=
# Fine-grained GitHub token with "Contents: Read and write" on this repo only.
GITHUB_TOKEN=
GITHUB_REPO=mayankmalik263/Portfolio-Website
GITHUB_BRANCH=main

# Analytics: use ONE of the two below.
#
# Option A (simplest) - Google Analytics 4 direct. Measurement ID, format G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
#
# Option B - Google Tag Manager container, format GTM-XXXXXXX.
# Use this instead of GA_ID if you route GA4 through GTM. Do NOT put a G- ID here.
NEXT_PUBLIC_GTM_ID=